{
  "name": "@polarislab/data-client",
  "version": "0.1.0",
  "private": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test src/**/*.test.ts",
    "generate:analytics": "node scripts/generate-analytics.mjs",
    "check:analytics": "node scripts/generate-analytics.mjs --check",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "example:liquidity-book": "tsx ../examples/typescript/liquidity-book-sol-usdc.ts",
    "example:paid": "tsx ../examples/typescript/paid-subscribe.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "openapi-typescript": "7.9.1"
  }
}
